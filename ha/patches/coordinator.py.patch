+    async def async_wait_connected(self, timeout: float = 15.0) -> None:
+        """等待 MQTT 连接并拿到第一份状态（broker 会立即推 retain）。"""
+        if self._mqtt_client is None:
+            return
+        import asyncio
+        import time as _time
+
+        deadline = _time.monotonic() + timeout
+        while _time.monotonic() < deadline:
+            if self._mqtt_client.connected and self._mqtt_client.get_state():
+                return
+            await asyncio.sleep(0.2)
+        _LOGGER.warning("petmarvel: 等待本地 broker 状态超时（%.0fs）", timeout)
