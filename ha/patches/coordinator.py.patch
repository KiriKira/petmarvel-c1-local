+    async def _data_from_mqtt(self, st: dict) -> PetMarvelAPIData:
+        """把 broker 的 state JSON 映射成原有数据结构，并把新记录并入本地 store。"""
+        last_usage = 0
+        raw_usage = st.get("last_usage")
+        if raw_usage:
+            try:
+                # 设备格式: "2026-11-02 18:14:32 1"（末尾是该日第几次）
+                stamp = raw_usage.rsplit(" ", 1)[0]
+                dt = datetime.strptime(stamp, "%Y-%m-%d %H:%M:%S").replace(
+                    tzinfo=ZoneInfo("Asia/Shanghai")
+                )
+                last_usage = int(dt.timestamp() * 1000)
+            except Exception:
+                _LOGGER.debug("petmarvel mqtt: last_usage 解析失败 %r", raw_usage)
+
+        # 新的如厕记录只在拿到设备时间时落库，避免用 HA 本地时间反复写入重复记录
+        new_records: list[dict[str, Any]] = []
+        cat_use = st.get("cat_use") or {}
+        if cat_use.get("weight_g") and last_usage:
+            new_records.append(
+                {
+                    "event_time": last_usage // 1000,
+                    "event_type": 1,
+                    "weight": cat_use.get("weight_g"),
+                    "duration": cat_use.get("duration_s"),
+                }
+            )
+        stored = await (
+            self._record_store.async_merge(new_records)
+            if new_records
+            else self._record_store.async_get_records()
+        )
+        records = sorted(
+            (self._normalize_record(record) for record in stored),
+            key=lambda record: record["event_time"],
+            reverse=True,
+        )
+        toilet_times = [r["event_time"] for r in records if r["event_type"] == 1]
+        if toilet_times:
+            last_usage = max(toilet_times) * 1000
+        activity = records[0] if records else None
+        overview = self._records_summary(records, {})
+        overview["records_source"] = "local_broker"
+
+        return PetMarvelAPIData(
+            work_status=int(st.get("work_status", 0) or 0),
+            up_lid_status=bool(st.get("lid_installed", True)),
+            drawer_status=bool(st.get("bin_inserted", True)),
+            full_status=bool(st.get("bin_full", False)),
+            last_usage=last_usage,
+            error_status=int(st.get("error_code", 0) or 0),
+            AutoClean=st.get("auto_clean", 0) == 1,
+            DeepClean=st.get("deep_clean", 0) == 1,
+            SmallCatMode=st.get("small_cat_mode", 0) == 1,
+            LightSwitch=st.get("light", 0) == 1,
+            software_version=str(st.get("fw_version", "")),
+            activity=activity,
+            records=records,
+            record_overview=overview,
+        )
