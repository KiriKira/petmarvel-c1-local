+async def async_probe_broker(hass, host: str, port: int) -> bool:
+    """确认 broker 的 HA 端口可连（发一个最小 MQTT CONNECT，期待 CONNACK）。"""
+
+    def _probe() -> bool:
+        import socket
+
+        try:
+            sock = socket.create_connection((host, int(port)), timeout=3)
+            client_id = b"ha-probe"
+            payload = (
+                b"\x00\x04MQTT\x04\x02\x00\x3c"
+                + len(client_id).to_bytes(2, "big")
+                + client_id
+            )
+            sock.sendall(bytes([0x10, len(payload)]) + payload)
+            resp = sock.recv(4)
+            sock.close()
+            return resp[:4] == b"\x20\x02\x00\x00"
+        except Exception as err:  # pragma: no cover - 探测失败即返回 False
+            _LOGGER.debug("petmarvel broker probe failed: %s", err)
+            return False
+
+    return await hass.async_add_executor_job(_probe)
+
 
