+class PetMarvelOptionsFlow(OptionsFlow):
+    """运行期开关：切到自建 broker 或回到云端。"""
+
+    async def async_step_init(
+        self, user_input: dict[str, Any] | None = None
+    ) -> ConfigFlowResult:
+        entry = self.config_entry
+        errors: dict[str, str] = {}
+
+        current_use_local = bool(
+            entry.options.get(
+                CONF_USE_LOCAL, entry.data.get("transport") == TRANSPORT_MQTT
+            )
+        )
+        current_host = (
+            entry.options.get(CONF_MQTT_HOST)
+            or entry.data.get(CONF_MQTT_HOST)
+            or DEFAULT_HOST
+        )
+        current_port = int(
+            entry.options.get(CONF_MQTT_PORT)
+            or entry.data.get(CONF_MQTT_PORT)
+            or DEFAULT_PORT
+        )
+
+        if user_input is not None:
+            use_local = bool(user_input[CONF_USE_LOCAL])
+            host = str(user_input.get(CONF_MQTT_HOST) or current_host).strip() or DEFAULT_HOST
+            port = int(user_input.get(CONF_MQTT_PORT) or current_port)
+            if use_local and not await async_probe_broker(self.hass, host, port):
+                errors["base"] = "cannot_connect"
+            else:
+                # 合并而不是覆盖，保住 device_key 等其它选项
+                new_options = dict(entry.options)
+                new_options.update(
+                    {
+                        CONF_USE_LOCAL: use_local,
+                        CONF_MQTT_HOST: host,
+                        CONF_MQTT_PORT: port,
+                    }
+                )
+                new_options.setdefault(
+                    "device_key",
+                    entry.data.get(CONF_FRIENDLY_NAME)
+                    or entry.data.get(CONF_DEVICE_ID)
+                    or "",
+                )
+                return self.async_create_entry(title="", data=new_options)
+
+        return self.async_show_form(
+            step_id="init",
+            data_schema=vol.Schema(
+                {
+                    vol.Required(CONF_USE_LOCAL, default=current_use_local): bool,
+                    vol.Optional(CONF_MQTT_HOST, default=current_host): str,
+                    vol.Optional(CONF_MQTT_PORT, default=current_port): int,
+                }
+            ),
+            errors=errors,
+        )
